# FinDoc AI — Environment Variables Configuration

# Aiven PostgreSQL Connection String:
# Format: postgresql://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?sslmode=require
DATABASE_URL=postgresql://avnadmin:your_password_here@pg-your-project.aivencloud.com:12345/defaultdb?sslmode=require

# Application settings
UPLOAD_DIR=./uploads
ARTIFACT_DIR=./artifacts
MODEL_PATH=./artifacts/isolation_forest_tuned.pkl

# Server settings
PORT=8000
HOST=0.0.0.0

# Gemini Vision AI Extraction (Optional - provides multimodal extraction replacing traditional OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

